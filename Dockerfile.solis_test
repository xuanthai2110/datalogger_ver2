# Multi-architecture Dockerfile for Raspberry Pi (ARM64 / ARMv7) and x86_64
FROM python:3.10-slim

# Prevent Python from writing .pyc files and buffer outputs
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install pymodbus version specified in project
RUN pip install --no-cache-dir pymodbus==3.6.7

# Copy test script into container
COPY backend/tests/test_solis_hybrid_registers.py /app/test_solis_hybrid_registers.py

# Default Environment Variables
ENV MODBUS_HOST=192.168.1.100
ENV MODBUS_PORT=502
ENV MODBUS_SLAVE=1
ENV MODBUS_TIMEOUT=3.0
ENV OFFSET_MODE=40001
ENV READ_INTERVAL=5

# Command to execute script with environment variables
CMD ["python", "test_solis_hybrid_registers.py"]
